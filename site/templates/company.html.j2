{% extends "base.html.j2" %}
{% import "_macros.html.j2" as m %}
{% set c = r.c %}
{% block path %}company/{{ r.id }}.html{% endblock %}
{% block title %}{{ c.name }}{% endblock %}
{% block description %}{{ c.name }}: {{ c.focus }}. Funding, valuation, open roles and announcements with sources.{% endblock %}
{% block body %}
<p>{% for sid, name in r.segments %}<a class="pill" href="../index.html#{{ sid }}">{{ name }}</a> {% endfor %}{% if c.boston %}<span class="tag">Greater Boston</span>{% endif %}</p>
<h1>{{ c.name }}</h1>
<p class="lede">{{ c.focus }}.</p>
<p class="sub">{{ r.stage }} · {{ c.hq }} · <a href="https://{{ c.domain }}">{{ c.domain }}</a>{% if c.boston_note %}<br>Boston tag: {{ c.boston_note }}{% endif %}</p>

<div class="figs">
  <div class="fig"><b>{{ m.valuation(r.valuation) }}</b><span>latest valuation{% if r.valuation %} ({{ r.valuation.date | show_date }}){% endif %}</span></div>
  <div class="fig"><b>{% if r.raised %}{% if r.raised_floor %}&ge;{% endif %}{{ r.raised | fmt("usd") }}{% else %}–{% endif %}</b><span>closed equity raised ({{ r.raised_n }} round{{ "" if r.raised_n == 1 else "s" }} with amounts)</span></div>
{% if r.market_value %}
  <div class="fig"><b>{% if r.market_value.cap %}{{ r.market_value.cap | fmt("usd") }}{% else %}{{ r.market_value.close }} {{ r.market_value.currency }}{% endif %}</b><span>{% if r.market_value.cap %}market value, {{ r.market_value.as_of }}{% else %}{{ r.market_value.ticker }} close, {{ r.market_value.as_of }} (no SEC share count){% endif %}</span></div>
{% endif %}
  <div class="fig"><b>{% if r.roles is not none %}{{ r.roles }}{% else %}–{% endif %}</b><span>{% if r.roles is not none %}open roles, {{ r.boston_roles }} in Greater Boston{% elif c.hiring_scope == "parent" %}open roles: board describes the parent{% elif r.careers_url %}open roles: <a href="{{ r.careers_url }}">careers page</a> (not counted){% else %}open roles: no public job board{% endif %}</span></div>
{% if r.headcount and r.headcount[0].n %}
  <div class="fig"><b>{% if r.headcount[0].qualifier == "approx" %}~{% endif %}{{ r.headcount[0].n | fmt }}</b><span>employees, {{ r.headcount[0].as_of }} ({{ r.headcount[0].via }})</span></div>
{% endif %}
</div>
{% if r.revenue or r.cash %}
<p class="sub">From SEC filings: {% if r.revenue %}revenue {{ r.revenue.value | float | fmt("usd") }} in {{ r.revenue.frame[2:] }}{% endif %}{% if r.revenue and r.cash %}; {% endif %}{% if r.cash %}cash {{ r.cash.value | float | fmt("usd") }} at {{ r.cash.end }}{% endif %}.</p>
{% endif %}

<h2>Funding and valuation</h2>
{% if r.funding %}
<div class="tw"><table>
<thead><tr><th>Date</th><th>Round</th><th class="n">Amount</th><th class="n">Valuation</th><th>Status</th><th>Detail</th><th>Sources</th></tr></thead>
<tbody>
{% for x in r.funding %}
<tr><td class="d">{{ x.date | show_date }}</td><td>{{ x.round or x.type_label }}</td><td class="n">{{ m.amount(x) }}</td><td class="n">{% if x.valuation %}{{ x.valuation | fmt("usd") }}{% else %}<span class="muted">–</span>{% endif %}</td><td>{{ x.status }}</td><td class="detail">{{ x.detail }}</td><td>{{ m.sources(x) }}</td></tr>
{% endfor %}
</tbody></table></div>
{% else %}<p class="sub">No disclosed rounds in the ledger.</p>{% endif %}

<h2>Events</h2>
{% if r.events %}
<div class="tw"><table>
<thead><tr><th>Date</th><th>Type</th><th>Status</th><th>Detail</th><th>Sources</th></tr></thead>
<tbody>
{% for x in r.events %}
<tr><td class="d">{{ x.date | show_date }}</td><td>{{ x.type_label }}</td><td>{{ x.status }}</td><td class="detail">{{ x.detail }}</td><td>{{ m.sources(x) }}</td></tr>
{% endfor %}
</tbody></table></div>
{% else %}<p class="sub">No deployments, deals, listings or other events in the ledger yet.</p>{% endif %}

{% if r.roles is not none %}
<h2>Open roles</h2>
<p class="sub">From the public job board, counted weekly ({{ r.roles_series | length }} snapshot{{ "" if r.roles_series | length == 1 else "s" }} so far, {{ r.roles_series[0][0] }} to {{ r.roles_series[-1][0] }}). Function is inferred from the job title.</p>
<div class="tw"><table class="bars">
<thead><tr><th>Function</th><th class="n">Roles</th><th></th></tr></thead>
<tbody>
{% set top = r.functions.values() | max %}
{% for k, v in r.functions | dictsort(by="value", reverse=true) %}
<tr><td>{{ functions.get(k, k) }}</td><td class="n">{{ v }}</td><td class="bar-cell"><div class="hbar" style="width: {{ (100 * v / top) | round(1) }}%"></div></td></tr>
{% endfor %}
</tbody></table></div>
{% endif %}

{% if r.headcount %}
<h2>Headcount</h2>
<div class="tw"><table>
<thead><tr><th>As of</th><th class="n">Employees</th><th>Source</th></tr></thead>
<tbody>
{% for h in r.headcount %}
<tr><td class="d">{{ h.as_of | show_date }}</td><td class="n">{% if h.n %}{% if h.qualifier == "approx" %}~{% endif %}{{ h.n | fmt }}{% else %}{{ h.via }}{% endif %}</td><td class="src">{% if h.source %}<a href="{{ h.source }}">{{ h.via if h.n else "source" }}</a>{% endif %}</td></tr>
{% endfor %}
</tbody></table></div>
{% endif %}

<h2>Recent headlines</h2>
{% if r.news %}
<div class="tw"><table>
<thead><tr><th>Date</th><th>Headline</th><th>Publisher</th></tr></thead>
<tbody>
{% for a in r.news %}
<tr><td class="d">{{ a.date }}</td><td class="hl"><a href="{{ a.url }}">{{ a.title }}</a></td><td>{{ a.publisher or a.domain }}{% if a.tier == "tier1" %} <span class="tag">tier 1</span>{% endif %}</td></tr>
{% endfor %}
</tbody></table></div>
{% else %}<p class="sub">No linked headlines yet.</p>{% endif %}
{% endblock %}
